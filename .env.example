# Instagram News Agent — Environment Variables
# Is file ko copy karo ".env" naam se aur apni values bharo

# Claude AI (anthropic.com se free tier milta hai)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Pexels (pexels.com/api pe free register karo)
PEXELS_API_KEY=your_pexels_key_here

# Instagram Business Account (Meta Developer Console se milta hai)
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
